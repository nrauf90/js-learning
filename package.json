{
  "name": "PK Galla Online",
  "version": "1.0.0",
  "description": "Point of sale and khata tracking for small businesses",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "start": "node scripts/dev-serve.mjs web",
    "dev:api": "node scripts/dev-serve.mjs api",
    "dev:api:plain": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "lint": "node scripts/lint-js.mjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:serve": "npm run mobile:build && node scripts/dev-serve.mjs mobile",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:assets": "npx capacitor-assets generate --assetPath brand --splashBackgroundColor #071a3d --splashBackgroundColorDark #071a3d --iconBackgroundColor #071a3d --iconBackgroundColorDark #071a3d",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "qa:milestone": "node scripts/qa-milestone.mjs",
    "qa:m1": "node scripts/qa-milestone.mjs M1",
    "qa:m2": "node scripts/qa-milestone.mjs M2",
    "qa:m3": "node scripts/qa-milestone.mjs M3",
    "qa:m4": "node scripts/qa-milestone.mjs M4",
    "qa:m6": "node scripts/qa-milestone.mjs M6",
    "qa:m7": "node scripts/qa-milestone.mjs M7",
    "qa:m8": "node scripts/qa-milestone.mjs M8",
    "qa:m9": "node scripts/qa-milestone.mjs M9",
    "qa:m10": "node scripts/qa-milestone.mjs M10",
    "qa:m11": "node scripts/qa-milestone.mjs M11",
    "qa:m12": "node scripts/qa-milestone.mjs M12",
    "qa:m13": "node scripts/qa-milestone.mjs M13",
    "qa:m23": "node scripts/qa-milestone.mjs M23",
    "qa:m35": "node scripts/qa-milestone.mjs M35",
    "test:admin": "node scripts/test-admin-setup.mjs",
    "wt": "node scripts/worktree.mjs",
    "wt:list": "node scripts/worktree.mjs list",
    "ports": "node scripts/agent-env.mjs"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "inventory",
    "cashflow",
    "pakistan"
  ],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
