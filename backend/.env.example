APP_NAME="Cashflow API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (XAMPP defaults). Create DB first:
#   CREATE DATABASE cashflow_app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cashflow_app
DB_USERNAME=root
DB_PASSWORD=

# Optional: keep sqlite for quick local boot without MySQL
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend SPA origin (vanilla app on port 3000)
FRONTEND_URL=http://localhost:3000
# Web app (3000), mobile preview via `npm run mobile:serve` (3100), and the
# Capacitor native webview — which serves bundled files from https://localhost
# rather than from any address, so it must be listed or the app's API calls are
# blocked by CORS with nothing in the Laravel log to show for it.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,https://localhost,capacitor://localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Google OAuth (create Web client; redirect URI must match)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback

# ---------------------------------------------------------------------------
# Billing (Paddle — merchant of record)
# ---------------------------------------------------------------------------
# Local development: leave the Paddle keys blank and turn this on. Checkout then
# completes locally without contacting Paddle, which is also what the Playwright
# harness relies on. NEVER set this on a publicly reachable instance — anyone
# could grant themselves a subscription.
BILLING_SANDBOX=true

BILLING_CURRENCY=USD
BILLING_TRIAL_DAYS=7

# Display amounts only. Paddle decides what is actually charged, so these must
# match the prices behind the price IDs below.
BILLING_AMOUNT_MONTHLY=5
BILLING_AMOUNT_YEARLY=54
BILLING_AMOUNT_RECEIPT_ADDON=5

# 'sandbox' or 'production'. Sandbox price IDs are not valid in production.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Notification-setting secret (pdl_ntfset_…). Webhook verification fails closed
# without it, so an unsigned request can never activate a subscription.
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE=300
# Approved payment-link domain. Leave blank to use the default payment link set
# in the Paddle dashboard (required — without one, Paddle returns a transaction
# with no checkout URL).
PADDLE_CHECKOUT_URL=
PADDLE_API_TIMEOUT=15

PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
PADDLE_PRICE_RECEIPT_ADDON=
